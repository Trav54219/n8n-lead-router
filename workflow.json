{
  "name": "Inbound lead router",
  "nodes": [
    {
      "id": "wh",
      "name": "Lead webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-in",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "code",
      "name": "Gate and score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "// Gate and score one inbound lead. Pure function so n8n's Code node and the tests run the same code.\nconst FREE = ['gmail.com', 'yahoo.com', 'outlook.com', 'hotmail.com', 'aol.com', 'icloud.com'];\nconst ROLE = ['info', 'sales', 'support', 'admin', 'contact', 'hello', 'office'];\nconst PERSONA = /(head|vp|director|manager|lead).*(growth|revenue|gtm|marketing|sales|operations)|founder|ceo|cro/i;\n\nfunction routeLead(lead) {\n  const email = String(lead.email || '').trim().toLowerCase();\n  if (!/^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$/.test(email)) return { route: 'reject', reason: 'invalid_email', score: 0 };\n  const [local, domain] = email.split('@');\n  if (FREE.includes(domain)) return { route: 'reject', reason: 'free_mail', score: 0 };\n  if (ROLE.includes(local)) return { route: 'reject', reason: 'role_inbox', score: 0 };\n  let score = 10; // email on a company domain\n  const reasons = ['company_domain +10'];\n  if (PERSONA.test(lead.title || '')) { score += 40; reasons.push('persona_title +40'); }\n  const n = Number(lead.employees);\n  if (n >= 20 && n <= 500) { score += 25; reasons.push('headcount_in_band +25'); }\n  const hits = ['outbound', 'pipeline', 'revops', 'saas', 'sales team'].filter(k =>\n    String(lead.description || '').toLowerCase().includes(k)).length;\n  if (hits) { const pts = Math.min(hits, 2) * 12.5; score += pts; reasons.push(`keywords(${hits}) +${pts}`); }\n  score = Math.round(score);\n  return { route: score >= 60 ? 'crm' : 'nurture', reason: reasons.join(', '), score };\n}\n\nreturn $input.all().map(i => ({ json: { ...i.json.body, ...routeLead(i.json.body) } }));"
      }
    },
    {
      "id": "sw",
      "name": "Route",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        480,
        0
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "crm",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "crm"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "nurture",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "nurture"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "reject",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "reject"
            }
          ]
        }
      }
    },
    {
      "id": "hs",
      "name": "Upsert HubSpot contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [
        740,
        -120
      ],
      "parameters": {
        "resource": "contact",
        "operation": "upsert",
        "email": "={{ $json.email }}",
        "additionalFields": {
          "firstName": "={{ $json.first_name }}",
          "jobTitle": "={{ $json.title }}",
          "companyName": "={{ $json.company }}"
        }
      }
    },
    {
      "id": "sl",
      "name": "Alert sales channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        980,
        -120
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#new-leads"
        },
        "text": "={{ $json.company }}: {{ $json.title }} scored {{ $json.score }} ({{ $json.reason }})"
      }
    },
    {
      "id": "nu",
      "name": "Nurture list",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        740,
        0
      ],
      "parameters": {}
    },
    {
      "id": "rj",
      "name": "Log rejected",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        740,
        120
      ],
      "parameters": {}
    }
  ],
